{
  "name": "relative-diagrams",
  "displayName": "Relative Diagrams",
  "description": "Renders Reladraw diagrams in the VS Code Markdown preview",
  "version": "0.2.0",
  "publisher": "VolkanUnsal",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/volkanunsal/relative-diagrams-vscode"
  },
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "categories": ["Visualization", "Other"],
  "keywords": ["reladraw", "diagram", "markdown", "svg", "preview"],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "activationEvents": ["onLanguage:markdown"],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": ["./media/previewScript.js"],
    "markdown.previewStyles": ["./media/previewStyles.css"],
    "languages": [
      {
        "id": "reladraw",
        "aliases": ["Reladraw", "reladraw"],
        "extensions": [".reladraw"],
        "configuration": "./syntaxes/reladraw.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "reladraw",
        "scopeName": "source.reladraw",
        "path": "./syntaxes/reladraw.tmLanguage.json"
      },
      {
        "scopeName": "markdown.reladraw.codeblock",
        "path": "./syntaxes/reladraw.markdown-injection.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.reladraw": "reladraw"
        }
      }
    ]
  },
  "scripts": {
    "grammar": "tsx scripts/writeGrammar.ts",
    "typecheck": "tsc -p . --noEmit",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "compile": "pnpm run typecheck && pnpm run build",
    "test": "node --test --import tsx test/*.test.ts",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run compile"
  },
  "dependencies": {
    "reladraw": "0.8.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.1",
    "jsdom": "^24.1.3",
    "markdown-it": "15.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
